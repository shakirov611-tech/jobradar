# Copy to .env.integration (ignored by Git); never paste credentials into chat.
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=REPLACE_WITH_LOCAL_N8N_API_KEY
N8N_GOOGLE_CREDENTIAL_ID=REPLACE_WITH_EXISTING_CREDENTIAL_ID
JR_PRODUCTION_SPREADSHEET_ID=REPLACE_WITH_REAL_PRODUCTION_ID
JR_TEST_SPREADSHEET_ID=REPLACE_WITH_SEPARATE_TEST_COPY_ID
JR_TEST_SHEET_NAME=JR_TEST_Vacancies

# Optional language enrichment (rules work without a key).
# JR_LANGUAGE_CONFIG=config/language-analysis.json
# JR_LANGUAGE_API_KEY=SET_LOCALLY_ONLY_WHEN_PROVIDER_IS_OPENAI
# JR_LANGUAGE_OVERRIDES=config/private/language-overrides.json
# Enable only after preparing the two headers in TEST then production Sheets.
# JR_LANGUAGE_SHEETS=1
