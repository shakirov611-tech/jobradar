{
  "name": "jobradar",
  "version": "0.7.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:integration": "node --env-file=.env.integration scripts/test-integration.cjs",
    "workflow:build": "node scripts/build-workflow.cjs && node scripts/build-first-seen-workflow.cjs",
    "collector:setup": "node --env-file=.env.integration scripts/deploy-collector.cjs",
    "collector:run": "node --env-file=.env.integration scripts/run-collector.cjs",
    "collector:test": "node --env-file=.env.integration scripts/run-collector.cjs --test",
    "collector:status": "node scripts/run-collector.cjs --status",
    "collector:automate": "node --env-file=.env.integration scripts/collector-schedule.cjs install",
    "collector:schedule:status": "node scripts/collector-schedule.cjs status",
    "collector:schedule:remove": "node scripts/collector-schedule.cjs remove",
    "test:applications": "node --test tests/application-spike.test.cjs",
    "applications:inspect": "node scripts/inspect-application.cjs",
    "browser:setup": "npm ci --prefix browser --ignore-scripts --no-audit --no-fund && node browser/node_modules/playwright/cli.js install chromium --only-shell",
    "test:browser": "node --test browser/tests/*.test.cjs",
    "applications:browser:dry-run": "node scripts/browser-dry-run.cjs",
    "collector:preview": "node --env-file=.env.integration scripts/preview-sources.cjs",
    "collector:run:legacy": "node --env-file=.env.integration scripts/run-collector.cjs --legacy",
    "lint": "eslint . --max-warnings=0",
    "check:config": "node scripts/check-config.cjs",
    "check": "npm run lint && npm run check:config && npm test",
    "matching:review": "node --env-file=.env.integration scripts/preview-sources.cjs --review",
    "matching:report": "node scripts/matching-report.cjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "16.5.0"
  }
}
